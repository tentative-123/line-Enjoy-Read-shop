# Railway admin dashboard image. NEXT_PUBLIC_API_URL is embedded by Next.js.
FROM node:22-bookworm-slim AS build
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV RAILWAY_ADMIN_PROXY=true
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN test -n "$NEXT_PUBLIC_API_URL" || (echo 'NEXT_PUBLIC_API_URL is required' >&2; exit 1) \
 && corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile \
 && pnpm --filter @line-crm/shared build \
 && pnpm --filter @line-harness/update-engine build \
 && pnpm --filter web build

FROM nginx:1.27-alpine
ARG NEXT_PUBLIC_API_URL
ENV BACKEND_URL=$NEXT_PUBLIC_API_URL
ENV NGINX_ENVSUBST_FILTER=BACKEND_URL
COPY deploy/nginx-admin.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/out /usr/share/nginx/html
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
